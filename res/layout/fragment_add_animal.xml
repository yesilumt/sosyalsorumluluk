<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E3F2FD"
    tools:context=".AddAnimalFragment">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:background="#FFFFFF"
            android:padding="20dp"
            android:clipToOutline="true"
            android:elevation="6dp"
            android:layout_margin="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hayvan Ekle"
                android:textSize="22sp"
                android:textColor="#1E88E5"
                android:fontFamily="sans-serif-medium"
                android:layout_marginBottom="14dp"
                android:textAlignment="center" />

            <EditText
                android:id="@+id/animalTypeInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Hayvan Türü"
                android:padding="12dp"
                android:layout_marginBottom="16dp"
                android:background="#E0E0E0"
                android:layout_margin="8dp" />

            <EditText
                android:id="@+id/locationInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Hayvanın Bulunduğu Yer"
                android:padding="12dp"
                android:layout_marginBottom="16dp"
                android:background="#E0E0E0"
                android:layout_margin="8dp" />

            <!-- Resim Önizleme -->
            <ImageView
                android:id="@+id/animalImageView"
                android:layout_width="200dp"
                android:layout_height="200dp"
                android:scaleType="centerCrop"
                android:background="#E0E0E0"
                android:layout_marginBottom="16dp" />

            <!-- Resim Seçme Butonu -->
            <Button
                android:id="@+id/selectImageButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Resim Seç"
                android:background="#1E88E5"
                android:textColor="#FFFFFF"
                android:padding="10dp"
                android:layout_marginBottom="16dp"
                android:layout_gravity="center" />

            <!-- Hayvan Ekle Butonu -->
            <Button
                android:id="@+id/addAnimalButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ekle"
                android:background="#1E88E5"
                android:textColor="#FFFFFF"
                android:padding="10dp"
                android:layout_marginTop="16dp"
                android:layout_gravity="center" />

        </LinearLayout>
    </ScrollView>
</FrameLayout>
