<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#9BA7D2"
    android:padding="24dp">

    <!-- Saat, sinyal ve pil göstergeleri üstte -->

    <!-- Logo -->
    <ImageView
        android:id="@+id/iv_logo"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="40dp"
        android:contentDescription="Logo"
        android:src="@drawable/logo" />

    <!-- Login Kart -->
    <LinearLayout
        android:id="@+id/card_login"
        android:layout_width="369dp"
        android:layout_height="589dp"
        android:layout_below="@id/iv_logo"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="16dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:background="#FFFFFF"
        android:clipToOutline="true"
        android:elevation="8dp"
        android:orientation="vertical"
        android:outlineProvider="background"
        android:padding="24dp">

        <!-- Login başlığı -->

        <!-- Alt başlık (Hoşgeldiniz) -->

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="Login"
            android:textColor="#000000"
            android:textSize="28sp"
            android:textStyle="bold" />

        <!-- Kullanıcı adı Kart (Beyaz arka plan) -->
        <TextView
            android:id="@+id/tv_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:text="Hello, Welcome back"
            android:textColor="#666666"
            android:textSize="16sp" />

        <LinearLayout
            android:id="@+id/card_username"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="#FFFFFF"
            android:elevation="4dp"
            android:orientation="vertical"
            android:padding="16dp">

            <EditText
                android:id="@+id/et_mail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/rounded_edit_text_background"
                android:hint="Mail"
                android:padding="12dp"
                android:inputType="text"
                android:drawableLeft="@android:drawable/ic_menu_edit"
                android:drawablePadding="12dp"
                android:clipToOutline="true" />
        </LinearLayout>

        <!-- Şifre Kart (Beyaz arka plan) -->
        <LinearLayout
            android:id="@+id/card_password"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="#FFFFFF"
            android:elevation="4dp"
            android:orientation="vertical"
            android:padding="16dp">

            <EditText
                android:id="@+id/et_password"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/rounded_edit_text_background"
                android:hint="Password"
                android:padding="12dp"
                android:inputType="textPassword"
                android:drawableLeft="@android:drawable/ic_lock_idle_lock"
                android:drawablePadding="12dp"
                android:clipToOutline="true" />
        </LinearLayout>

        <!-- Kayıt ol bağlantısı -->
        <Button
            android:id="@+id/btn_login"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="#2196F3"
            android:padding="12dp"
            android:text="Log in"
            android:onClick="btnlogin"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:clipToOutline="true" />

        <TextView
            android:id="@+id/tv_signup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:onClick="btnsignup"
            android:text="Don’t have an account? Sign up"
            android:textColor="#6A1B9A"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>

</RelativeLayout>