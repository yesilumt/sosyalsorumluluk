<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E3F2FD"
    tools:context=".HomeFragment">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:background="#FFFFFF"
            android:padding="20dp"
            android:clipToOutline="true"
            android:elevation="6dp"
            android:layout_margin="12dp">

            <!-- Başlık -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sokak Hayvanları Uygulaması"
                android:textSize="22sp"
                android:textColor="#1E88E5"
                android:fontFamily="sans-serif-medium"
                android:layout_marginBottom="14dp"
                android:textAlignment="center" />

            <!-- Açıklama Metni -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Bu uygulama, sokak hayvanlarının yaşadığı yerleri öğrenmek ve yeni yerler eklemek amacıyla geliştirilmiştir. Amacımız, yardıma ihtiyacı olan sokak hayvanlarını belirlemek ve bu konuda duyarlı bireylerin katkısını kolaylaştırmaktır."
                android:textSize="16sp"
                android:textColor="#546E7A"
                android:lineSpacingExtra="5dp"
                android:gravity="center"
                android:layout_marginBottom="16dp" />

            <!-- Görsel -->
            <ImageView
                android:layout_width="220dp"
                android:layout_height="220dp"
                android:src="@drawable/logo"
                android:contentDescription="Sokak hayvanları resmi"
                android:scaleType="centerCrop"
                android:layout_marginBottom="20dp"
                android:background="#E0E0E0"
                android:clipToOutline="true" />

            <!-- Alt Açıklama -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Uygulama sayesinde, çevrenizdeki hayvanların yaşam alanlarını harita üzerinde görebilir ve yeni yaşam alanları ekleyerek onların daha iyi koşullarda hayat sürmesine yardımcı olabilirsiniz. İnsanların sokak hayvanlarına yönelik farkındalığını artırmayı hedefleyen bu platform, duyarlı bireylerin yardımlarıyla daha güçlü bir etki yaratabilir."
                android:textSize="16sp"
                android:textColor="#546E7A"
                android:lineSpacingExtra="5dp"
                android:gravity="center" />

        </LinearLayout>
    </ScrollView>
</FrameLayout>
